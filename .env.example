# --- AI Providers ---
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
DEEPSEEK_API_KEY=your-deepseek-api-key
GOOGLE_GEMINI_API_KEY=your-gemini-api-key
TAVILY_API_KEY=your-tavily-api-key

# --- Auth ---
FIREBASE_PROJECT_ID=forgeai-auth
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@forgeai-auth.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
JWT_SECRET=super-secret-forgeai-jwt-key-change-in-production

# --- Infra ---
DATABASE_URL=postgresql+asyncpg://forge:forge@postgres:5432/forgeai
DATABASE_URL_SYNC=postgresql://forge:forge@postgres:5432/forgeai
REDIS_URL=redis://redis:6379/0

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=forgeai-auth.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=forgeai-auth
